{
  "keym": {
    "action": {
      "layerType": "segmentation",
      "tool": "grapheneMergeSegments",
      "provider": "graphene"
    }
  },
  "keyc": {
    "action": {
      "layerType": "segmentation",
      "tool": "grapheneMulticutSegments",
      "provider": "graphene"
    }
  },
  "keyf": {
    "action": {
      "layerType": "segmentation",
      "tool": "grapheneFindPath",
      "provider": "graphene"
    }
  },
  "keyx": {
    "action": false
  },
  "control+shift+keyx": {
    "action": "clear-segments"
  },
  "bracketleft": {
    "action": {
      "layerType": "annotation",
      "tool": "selectPreviousAnnotation"
    }
  },
  "bracketright": {
    "action": {
      "layerType": "annotation",
      "tool": "selectNextAnnotation"
    }
  }
}
